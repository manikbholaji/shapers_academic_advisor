# Copy this to .streamlit/secrets.toml locally OR add on Streamlit Community Cloud
# Keep your real keys secret and never commit them.
OPENAI_API_KEY = "your-openai-key-here"
GOOGLE_API_KEY = "your-google-ai-studio-key-here"
DIALOGFLOW_PROJECT_ID = "your-dialogflow-project-id"
DIALOGFLOW_ACCESS_TOKEN = "your-dialogflow-bearer-access-token"
